# Copiar a .env. El .env real nunca entra al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://fedesoft:cambiar@localhost:5432/fedesoft_dev?schema=public"
REDIS_URL="redis://localhost:6379"
# Obligatorio en producción. Sin comodín.
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
# Mínimo 32 caracteres. Genera uno propio: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=""

# Identidad (ADR-008). En desarrollo apuntan al Keycloak de infra/docker.
API_PUBLIC_URL="http://localhost:3000"
PORTAL_URL="http://localhost:3001"
CONSOLE_URL="http://localhost:3002"
OIDC_ISSUER_URL="http://localhost:8080/realms/fedesoft"
OIDC_CLIENT_ID="portal-api"
# Solo para el Keycloak local. En cualquier otro entorno sale del gestor de secretos.
OIDC_CLIENT_SECRET="cambiar-secreto-local-del-cliente"
OIDC_MFA_VALUES="otp,mfa"
OIDC_CONSOLE_MAX_AGE_SEC=900
# Saltos de proxy delante del API. 0 en local.
TRUST_PROXY_HOPS=0
