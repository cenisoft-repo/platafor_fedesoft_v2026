# Copiar a .env. El .env real nunca entra al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://fedesoft:cambiar@localhost:5432/fedesoft_dev?schema=public"
REDIS_URL="redis://localhost:6379"
# Obligatorio en producción. Sin comodín.
CORS_ORIGINS="http://localhost:3001"
# Secreto compartido con la pasarela: mínimo 32 caracteres, sin valor por defecto.
PAYMENT_WEBHOOK_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"

# ── Identidad (ADR-008) ────────────────────────────────────────────────
# Obligatorio y explícito: no hay valor por defecto, porque el valor cómodo
# ('stub') es el inseguro. 'stub' es el proveedor de desarrollo: recorre el
# mismo flujo sin pedir credenciales, y el arranque falla si aparece con
# NODE_ENV=production o con SESSION_COOKIE_SECURE=true (es decir, con TLS).
IDENTITY_PROVIDER=stub
# Con IDENTITY_PROVIDER=oidc los tres primeros son obligatorios.
# OIDC_ISSUER_URL="http://localhost:8080/realms/fedesoft"
# OIDC_CLIENT_ID="portal-afiliado"
# OIDC_CLIENT_SECRET="cambiar"
OIDC_REDIRECT_URI="http://localhost:3000/v1/auth/callback"
OIDC_SCOPE="openid profile email"
# Valor de `acr` con el que el proveedor declara el segundo factor.
OIDC_MFA_ACR="mfa"

# Destinos a los que se permite volver tras autenticar, separados por coma.
APP_RETURN_URLS="http://localhost:3001/"

# Saltos hasta el balanceador. 0 = sin proxy delante. Detrás de un ingress,
# sin esto el límite de tasa se comparte entre todos y la auditoría registra
# siempre la IP del proxy.
TRUSTED_PROXY_HOPS=0

SESSION_ABSOLUTE_MINUTES=480
SESSION_IDLE_MINUTES=30
# Solo false en desarrollo local, que no tiene HTTPS.
SESSION_COOKIE_SECURE=false
