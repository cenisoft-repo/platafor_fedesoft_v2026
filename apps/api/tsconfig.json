{
  "extends": "@fedesoft/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    /* nest build borra dist/ (deleteOutDir) pero el .tsbuildinfo vivía fuera:
       tsc creía todo compilado y emitía un dist/ incompleto que no arrancaba. */
    "incremental": false
  },
  "include": ["src/**/*.ts"]
}
