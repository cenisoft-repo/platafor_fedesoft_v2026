# Copiar a .env y ajustar. El .env real nunca entra al repositorio.
DATABASE_URL="postgresql://fedesoft:cambiar@localhost:5432/fedesoft_dev?schema=public"
# La semilla solo corre contra una base local. Para una base remota de pruebas con datos
# ficticios (nunca producción) descomenta esto de forma explícita. Ver ADR-009.
# ALLOW_SYNTHETIC_SEED=1
