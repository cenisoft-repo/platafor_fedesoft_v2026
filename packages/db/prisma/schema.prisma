// Modelo de datos del núcleo — Portal Único del Afiliado.
//
// Tres reglas gobiernan este archivo:
//   1. Organization, Contact y Membership viven aquí y en ningún otro lugar.
//      Ningún módulo crea su "versión" de empresa, contacto o estado de pago.
//   2. organizationId es la frontera de seguridad. Toda tabla que cuelgue de
//      una empresa lo lleva y lo indexa, porque toda consulta lo filtra.
//   3. Las reglas de negocio configurables viven en Parameter, no en columnas
//      con valores por defecto ni en constantes del código.
//
// Ver ADR-001 (monolito modular), ADR-002 (stack) y ADR-006 (fundación).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ─────────────────────────── Enumeraciones ─────────────────────────── */

enum Segment {
  MIPYME
  GRANDE
}

enum OrganizationStatus {
  PROSPECTO
  ACTIVA
  SUSPENDIDA
  RETIRADA
}

enum MembershipType {
  ACTIVO
  ADHERENTE
}

enum MembershipStatus {
  AL_DIA
  PENDIENTE
  VENCIDA
  CANCELADA
}

enum ChargeStatus {
  PENDIENTE
  PAGADO
  VENCIDO
  ANULADO
}

enum PaymentStatus {
  INICIADO
  EN_PROCESO
  APROBADO
  RECHAZADO
  REVERSADO
}

enum InvoiceStatus {
  EN_PROCESO
  EMITIDA
  RECHAZADA
  ANULADA
}

enum CertificateStatus {
  VIGENTE
  REVOCADO
}

enum AffiliationRequestStatus {
  NUEVA
  EN_REVISION
  INFO_SOLICITADA
  APROBADA
  RECHAZADA
}

enum UserStatus {
  ACTIVO
  INVITADO
  BLOQUEADO
}

enum ParameterScope {
  GLOBAL
  SEGMENTO
  ORGANIZACION
}

enum OutboxStatus {
  PENDIENTE
  PUBLICADO
  FALLIDO
}

enum SessionStatus {
  ACTIVA
  REVOCADA
  EXPIRADA
}

/* ─────────────────────────────── Núcleo ─────────────────────────────── */

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  /// NIT sin puntos ni guion, con dígito de verificación aparte: un NIT es
  /// una identidad, y escribirlo de dos formas crearía dos empresas.
  nit       String             @unique @db.VarChar(15)
  nitDv     String             @map("nit_dv") @db.Char(1)
  legalName String             @map("legal_name") @db.VarChar(300)
  tradeName String?            @map("trade_name") @db.VarChar(300)
  segment   Segment
  status    OrganizationStatus @default(PROSPECTO)
  employees Int?
  city      String?            @db.VarChar(120)
  sector    String?            @db.VarChar(180)
  website   String?            @db.VarChar(300)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts          Contact[]
  memberships       Membership[]
  charges           Charge[]
  payments          Payment[]
  invoices          Invoice[]
  certificates      Certificate[]
  organizationUsers OrganizationUser[]
  auditEvents       AuditEvent[]
  sessions          Session[]

  @@index([status])
  @@index([segment])
  @@map("organizations")
}

model Contact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  /// Normalizado a minúsculas antes de escribir: dos mayúsculas distintas no
  /// pueden ser dos personas distintas dentro de la misma empresa.
  email          String   @db.VarChar(320)
  phone          String?  @db.VarChar(40)
  jobTitle       String?  @map("job_title") @db.VarChar(180)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationUsers OrganizationUser[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("contacts")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique @db.VarChar(320)
  /// En desuso desde ADR-008: la identidad federada vive en UserIdentity, que
  /// guarda emisor y sujeto por separado. La columna se retira en una
  /// migración posterior, cuando ningún código la lea (expand/contract).
  authSubject String?    @unique @map("auth_subject") @db.VarChar(255)
  status      UserStatus @default(INVITADO)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizationUsers OrganizationUser[]
  identities        UserIdentity[]
  sessions          Session[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  /// Un rol interno pertenece a Fedesoft; uno externo, a una empresa afiliada.
  internal    Boolean  @default(false)
  /// Exige que la sesión traiga segundo factor acreditado por el proveedor de
  /// identidad (ADR-008). Es una propiedad del rol, no un parámetro de
  /// negocio: describe qué es el rol, no una regla que Fedesoft ajusta.
  mfaRequired Boolean  @default(false) @map("mfa_required")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organizationUsers OrganizationUser[]

  @@map("roles")
}

model OrganizationUser {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  contactId      String?  @map("contact_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_users")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  type           MembershipType
  status         MembershipStatus
  validFrom      DateTime         @map("valid_from") @db.Date
  /// Abierto mientras la afiliación siga vigente. El historial se conserva:
  /// un cambio de estado cierra el período y abre otro, nunca sobrescribe.
  validTo        DateTime?        @map("valid_to") @db.Date
  reason         String?          @db.VarChar(300)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, validFrom])
  @@index([status])
  @@map("memberships")
}

/* ───────────────────────── Cartera y facturación ───────────────────── */

model Charge {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  concept            String       @db.VarChar(240)
  period             String       @db.VarChar(20)
  /// Decimal, nunca punto flotante: el dinero no se redondea por accidente.
  amount             Decimal      @db.Decimal(14, 2)
  currency           String       @default("COP") @db.Char(3)
  dueDate            DateTime     @map("due_date") @db.Date
  status             ChargeStatus @default(PENDIENTE)
  /// Tarifa que lo originó, para poder explicar de dónde salió el monto.
  parameterVersionId String?      @map("parameter_version_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parameterVersion ParameterVersion? @relation(fields: [parameterVersionId], references: [id], onDelete: SetNull)
  payments         PaymentCharge[]

  @@unique([organizationId, concept, period])
  @@unique([id, organizationId], map: "charges_id_org_unique")
  @@index([organizationId, status])
  @@index([dueDate])
  @@map("charges")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("COP") @db.Char(3)
  /// Nombre del adaptador, no del dominio: "wompi", "epayco"… El dominio no
  /// sabe quién cobra (regla no negociable del proyecto).
  provider          String        @db.VarChar(40)
  providerReference String?       @map("provider_reference") @db.VarChar(180)
  status            PaymentStatus @default(INICIADO)
  /// Referencia que viaja a la pasarela y vuelve en el webhook. La genera el
  /// servidor, es opaca y no adivinable: nunca el NIT, el id de un cargo ni
  /// un consecutivo. Es por la que el webhook encuentra el pago.
  reference         String        @unique @db.VarChar(64)
  /// Del cliente, para que reintentar no cree un segundo pago. Única **por
  /// empresa**: si fuera global, adivinar la clave de otra organización
  /// devolvería su pago, y reservarlas sería una denegación de servicio.
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(120)
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  failureReason     String?       @map("failure_reason") @db.VarChar(300)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  charges      PaymentCharge[]
  invoice      Invoice?

  @@unique([provider, providerReference])
  @@unique([organizationId, idempotencyKey])
  /// Requisito de las claves foráneas compuestas de payment_charges e
  /// invoices: sin esta unicidad no se puede referenciar el par.
  @@unique([id, organizationId], map: "payments_id_org_unique")
  @@index([organizationId, status])
  @@map("payments")
}

/// Un pago puede saldar varios cargos, y un cargo puede recibir varios pagos.
///
/// `organizationId` no es una comodidad de consulta: es lo que permite atar
/// pago y cargo a la MISMA empresa por clave foránea compuesta. Sin él, las
/// dos claves son independientes y nada impide que un pago salde el cargo de
/// otra organización —con factura al NIT equivocado—. Un `if` en el servicio
/// lo evita hasta que alguien escribe el siguiente endpoint.
model PaymentCharge {
  paymentId      String  @map("payment_id") @db.Uuid
  chargeId       String  @map("charge_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  amount         Decimal @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "pc_payment_same_org")
  charge  Charge  @relation(fields: [chargeId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "pc_charge_same_org")

  @@id([paymentId, chargeId])
  @@index([organizationId])
  @@map("payment_charges")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  paymentId       String        @unique @map("payment_id") @db.Uuid
  number          String?       @unique @db.VarChar(40)
  /// Código Único de Factura Electrónica. Nulo mientras la DIAN no responda:
  /// una factura sin CUFE no está emitida, y el estado debe poder decirlo.
  cufe            String?       @unique @db.VarChar(96)
  status          InvoiceStatus @default(EN_PROCESO)
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(6)
  /// Respuesta cruda del facturador, para poder auditar y reconciliar.
  providerPayload Json?         @map("provider_payload")
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Compuesta a propósito: una factura no puede salir a nombre de una
  /// empresa distinta de la que hizo el pago.
  payment      Payment      @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "invoice_payment_same_org")

  /// Requisito de la clave foránea compuesta hacia payments. La unicidad que
  /// de verdad importa —una factura por pago— la da `paymentId @unique`.
  @@unique([paymentId, organizationId], map: "invoices_payment_org_unique")
  @@index([organizationId, status])
  @@map("invoices")
}

model Certificate {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  folio              String            @unique @db.VarChar(40)
  /// Retrato del estado en el momento de emitir: qué decía la afiliación,
  /// bajo qué regla y con qué vigencia. El PDF debe poder reconstruirse.
  membershipSnapshot Json              @map("membership_snapshot")
  status             CertificateStatus @default(VIGENTE)
  issuedAt           DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  validUntil         DateTime          @map("valid_until") @db.Date
  fileKey            String?           @map("file_key") @db.VarChar(400)
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("certificates")
}

/* ───────────────────── Afiliación: la puerta de entrada ────────────── */

model AffiliationRequest {
  id           String                   @id @default(uuid()) @db.Uuid
  /// El número que ve la empresa. Es su único asidero hasta que exista la
  /// organización, así que es único y no se reutiliza.
  filingNumber String                   @unique @map("filing_number") @db.VarChar(30)
  nit          String                   @db.VarChar(15)
  nitDv        String                   @map("nit_dv") @db.Char(1)
  legalName    String                   @map("legal_name") @db.VarChar(300)
  segment      Segment
  employees    Int
  city         String                   @db.VarChar(120)
  sector       String                   @db.VarChar(180)
  website      String?                  @db.VarChar(300)
  contactName  String                   @map("contact_name") @db.VarChar(200)
  contactEmail String                   @map("contact_email") @db.VarChar(320)
  contactPhone String                   @map("contact_phone") @db.VarChar(40)
  contactRole  String                   @map("contact_role") @db.VarChar(180)
  status       AffiliationRequestStatus @default(NUEVA)
  documents    Json                     @default("[]")
  notes        String?                  @db.Text
  /// Consentimiento Ley 1581: cuándo se dio y sobre qué texto. Sin esto no
  /// se puede tratar el dato, así que no es opcional en la práctica.
  consentAt    DateTime?                @map("consent_at") @db.Timestamptz(6)
  consentText  String?                  @map("consent_text") @db.VarChar(120)
  resolvedAt   DateTime?                @map("resolved_at") @db.Timestamptz(6)
  resolvedBy   String?                  @map("resolved_by") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([nit])
  @@map("affiliation_requests")
}

/* ──────────────── Config: las reglas que Fedesoft cambia ───────────── */

model Parameter {
  id          String         @id @default(uuid()) @db.Uuid
  key         String         @unique @db.VarChar(120)
  description String         @db.VarChar(400)
  scope       ParameterScope @default(GLOBAL)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  versions ParameterVersion[]

  @@map("parameters")
}

/// Un parámetro cambia creando una versión nueva, nunca editando la vigente:
/// un cargo emitido debe poder explicar bajo qué regla se calculó.
model ParameterVersion {
  id          String    @id @default(uuid()) @db.Uuid
  parameterId String    @map("parameter_id") @db.Uuid
  version     Int
  value       Json
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  approvedBy  String    @map("approved_by") @db.VarChar(240)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  charges   Charge[]

  @@unique([parameterId, version])
  @@index([parameterId, validFrom])
  @@map("parameter_versions")
}

/* ───────────────── Integridad: outbox, webhooks, auditoría ─────────── */

/// Patrón outbox: el cambio y su evento se confirman en la misma transacción.
/// Si el proceso muere antes de publicar, el evento sigue aquí.
model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(80)
  aggregateType String       @map("aggregate_type") @db.VarChar(60)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String?      @map("correlation_id") @db.VarChar(64)
  status        OutboxStatus @default(PENDIENTE)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.VarChar(500)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_messages")
}

/// Un webhook entrante se registra antes de procesarse. La clave única es la
/// defensa contra reenvíos: el mismo evento del mismo proveedor entra una vez.
model WebhookDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String    @db.VarChar(40)
  eventId     String    @map("event_id") @db.VarChar(180)
  signature   String    @db.VarChar(400)
  /// Marca de tiempo del proveedor, para rechazar reenvíos fuera de ventana.
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?   @db.VarChar(500)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_deliveries")
}

/// Append-only. No hay update ni delete sobre esta tabla desde ninguna
/// pantalla; la migración instala un trigger que lo impide en la base.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actor          String   @db.VarChar(240)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String   @db.VarChar(120)
  objectType     String   @map("object_type") @db.VarChar(60)
  objectId       String?  @map("object_id") @db.VarChar(80)
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  correlationId  String?  @map("correlation_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([objectType, objectId])
  @@map("audit_events")
}

/* ───────────────────────── Identidad y sesión ───────────────────────── */

/// Vínculo con el proveedor de identidad (ADR-008). Emisor y sujeto van en
/// columnas separadas: es lo que permite cambiar de proveedor —o convivir con
/// dos durante una migración— sin perder a quién pertenece la cuenta.
/// Aquí no vive ninguna credencial: la autenticación es del proveedor.
model UserIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuer    String   @db.VarChar(255)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identities")
}

/// Sesión del portal. El navegador lleva un identificador opaco de 256 bits;
/// aquí solo se guarda su hash, de modo que una copia de esta tabla no permite
/// suplantar a nadie. No hay JWT con permisos: un token autocontenido no se
/// revoca a tiempo, y quitar un rol debe sentirse en la petición siguiente.
model Session {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  /// SHA-256 del identificador de sesión. Nunca el valor en claro.
  tokenHash            String        @unique @map("token_hash") @db.Char(64)
  /// SHA-256 del token anti-CSRF que acompaña a los verbos mutantes.
  csrfTokenHash        String        @map("csrf_token_hash") @db.Char(64)
  /// Empresa sobre la que opera la sesión. Sale de aquí y de ningún otro
  /// lugar: jamás del cuerpo de una petición.
  activeOrganizationId String?       @map("active_organization_id") @db.Uuid
  status               SessionStatus @default(ACTIVA)
  /// Momento en que el proveedor acreditó el segundo factor. Nulo significa
  /// que esta sesión no lo tiene, no que el usuario no lo haya enrolado.
  mfaSatisfiedAt       DateTime?     @map("mfa_satisfied_at") @db.Timestamptz(6)
  issuedAt             DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt            DateTime      @map("expires_at") @db.Timestamptz(6)
  lastSeenAt           DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedReason        String?       @map("revoked_reason") @db.VarChar(120)
  ipAddress            String?       @map("ip_address") @db.VarChar(64)
  userAgent            String?       @map("user_agent") @db.VarChar(300)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

/// Intento de inicio de sesión en curso. Guarda el estado que OIDC exige de un
/// solo uso —`state`, `nonce` y el verificador PKCE— del lado del servidor,
/// porque un `state` que viaje solo en el navegador no prueba nada.
model AuthTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  /// SHA-256 del `state`. Se consume al canjear el código y no se reutiliza.
  stateHash    String    @unique @map("state_hash") @db.Char(64)
  /// SHA-256 de un secreto que viaja en cookie durante el login. Ata la vuelta
  /// del proveedor al navegador que la inició: sin esto, un atacante puede
  /// hacer que la víctima complete *su* login y quedarse operando dentro de la
  /// sesión del atacante sin notarlo.
  bindingHash  String    @map("binding_hash") @db.Char(64)
  nonce        String    @db.VarChar(120)
  codeVerifier String    @map("code_verifier") @db.VarChar(200)
  /// A dónde vuelve el navegador después del login. Validada contra la lista
  /// de destinos permitidos antes de escribirse: aquí no entra un destino
  /// arbitrario, o el login sería un redirector abierto.
  returnTo     String    @map("return_to") @db.VarChar(500)
  /// Se pidió segundo factor al proveedor en esta transacción.
  mfaRequested Boolean   @default(false) @map("mfa_requested")
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_transactions")
}
